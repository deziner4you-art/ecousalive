DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
APP_URL=https://yourdomain.com/aplus
APP_ENV=production

# PUBLIC_URL: web-visible URL of the public/ folder.
# Subdomain with doc root = public/ → same as APP_URL (no /public suffix)
# Subdirectory deployment            → APP_URL/public
PUBLIC_URL=https://yourdomain.com/aplus/public

# AI Generation Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
