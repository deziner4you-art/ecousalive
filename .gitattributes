# Handle line endings automatically
* text=auto

# PHP files — keep LF on server
*.php text eol=lf

# JS/CSS files
*.js text eol=lf
*.css text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
.htaccess text eol=lf
.env.example text eol=lf
*.json text eol=lf
*.md text eol=lf

# Images — binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
